# Copy to .env and fill in values locally. Never commit keys or share them in chat.
MEMORYSEAL_DATABASE_URL=sqlite:///./memoryseal.db
MEMORYSEAL_ENCRYPTION_KEY=
MEMORYSEAL_REQUEST_AUDIENCE=memoryseal-local

# Optional private inference; both values are required to enable it.
MEMORYSEAL_ZERO_G_API_KEY=
MEMORYSEAL_ZERO_G_MODEL=
MEMORYSEAL_ZERO_G_NETWORK=testnet
# Experimental bridge; requires provider pins, an operator-reviewed binary, and
# explicitly disabling the gateway attestation check. Use only with test data.
MEMORYSEAL_ZERO_G_EXPERIMENTAL_BRIDGE=false
MEMORYSEAL_ZERO_G_BRIDGE_EXECUTABLE=
MEMORYSEAL_ZERO_G_BRIDGE_SHA256=
# Optional strict provider quote check; also requires the 0G registry RPC below.
MEMORYSEAL_ZERO_G_PROVIDER_VERIFIER=
MEMORYSEAL_ZERO_G_PROVIDER_VERIFIER_SHA256=
MEMORYSEAL_DASHBOARD_ORIGINS=http://localhost:3000
# Require gateway connection verification before sending inference content.
# This experimental check requires a trusted, operator-built verifier binary.
MEMORYSEAL_REQUIRE_CONNECTION_ATTESTATION=true
MEMORYSEAL_CONNECTION_ATTESTATION_VERIFIER=
MEMORYSEAL_CONNECTION_ATTESTATION_VERIFIER_SHA256=
# Unsafe test-only compatibility: allow observations with unbound inference responses.
MEMORYSEAL_ALLOW_UNBOUND_INFERENCE=false

# Optional pinned response-signature verification; configure all three together.
MEMORYSEAL_ZERO_G_PROVIDER_ADDRESS=
MEMORYSEAL_ZERO_G_TEE_SIGNER=
MEMORYSEAL_ZERO_G_SIGNATURE_BASE_URL=
# Optional: compare all pins to the chosen network’s service registry before sending.
MEMORYSEAL_ZERO_G_REGISTRY_RPC_URL=

# Optional Arkiv Rabdi publisher; use a dedicated funded testnet wallet.
MEMORYSEAL_ARKIV_PRIVATE_KEY=
# Public publisher address supports read-only queries without the private key.
MEMORYSEAL_ARKIV_CREATOR_ADDRESS=
MEMORYSEAL_ARKIV_ACCESS_KEY=

# Optional onchain receipt observer.
MEMORYSEAL_ONCHAIN_RPC_URL=
MEMORYSEAL_ONCHAIN_CHAIN_ID=
MEMORYSEAL_ONCHAIN_EXECUTOR=
MEMORYSEAL_ONCHAIN_REGISTRY=
MEMORYSEAL_REQUIRE_ONCHAIN_MEMORY=false

# Optional server-side ENS observer; supports mainnet and sepolia.
MEMORYSEAL_ENS_RPC_URL=
MEMORYSEAL_ENS_NETWORK=sepolia

# Deployment and demo scripts read these from the shell environment.
MEMORYSEAL_RPC_URL=
MEMORYSEAL_CHAIN_ID=
MEMORYSEAL_DEPLOYER_KEY=
MEMORYSEAL_DEMO_OWNER_KEY=

# Optional separate demo agent signing keys and Sepolia RPC (shell environment).
MEMORYSEAL_DEMO_BROWSER_KEY=
MEMORYSEAL_DEMO_RESEARCH_KEY=
MEMORYSEAL_DEMO_FINANCE_KEY=
MEMORYSEAL_DEMO_RPC_URL=
