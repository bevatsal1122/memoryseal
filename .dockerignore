# Allowlist the gateway build inputs. Never include local keys or databases.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!src/
!src/**
!deploy/
!deploy/start_gateway.py
!deploy/compiler/
!deploy/compiler/package.json
!deploy/compiler/package-lock.json
!integrations/
!integrations/ens/
!integrations/ens/**
!integrations/arkiv/
!integrations/arkiv/**
!contracts/
!contracts/package.json
!contracts/package-lock.json
!contracts/src/
!contracts/src/**
!contracts/scripts/
!contracts/scripts/compile.mjs
**/node_modules
**/__pycache__
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.pem
**/*.key
